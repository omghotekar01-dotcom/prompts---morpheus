{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morpheus.local/schema/release-manifest-v2.json",
  "title": "MORPHEUS Release Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "commit",
    "artifacts",
    "available_evidence_roles",
    "claims",
    "claim_gate",
    "truth_boundaries",
    "manifest_sha256",
    "release_state"
  ],
  "properties": {
    "schema": {"const": "morpheus-release-manifest-v2"},
    "version": {"type": "string", "minLength": 1, "maxLength": 128},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "available_evidence_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text", "evidence_roles_declared", "declared_roles_missing_from_artifacts"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_roles_declared": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "declared_roles_missing_from_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "claim_gate": {
      "type": "object",
      "required": ["allowed", "decisions", "evidence_state"],
      "properties": {
        "allowed": {"type": "boolean"},
        "decisions": {"type": "array"},
        "evidence_state": {"type": "string"}
      }
    },
    "truth_boundaries": {"type": "array", "items": {"type": "string"}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_state": {"enum": ["CLAIMS_EVIDENCE_COMPLETE", "BLOCKED_BY_CLAIM_EVIDENCE"]}
  }
}
