# MORPHEUS guarded single-node pilot environment.
# Copy to .env (ignored by Git). Never commit the populated file.
#
# Generate the control-plane secret, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# REQUIRED for a guarded network/public pilot.
# Minimum 24 characters. Use a fresh random secret, not this file as a secret store.
MORPHEUS_API_KEY=
MORPHEUS_RATE_LIMIT_PER_MINUTE=120

# REQUIRED only for compose.public.yaml.
# Bare DNS hostname only (no scheme/path/port). Point DNS at the pilot host first.
MORPHEUS_DOMAIN=

# OPTIONAL: only when a browser frontend is hosted on a different origin.
# The packaged Docker UI is same-origin and needs no override.
# MORPHEUS_PILOT_BROWSER_ORIGINS=https://app.example.com

# OPTIONAL AI language/drafting layer.
# Deterministic MORPHEUS remains fully functional when disabled.
# Supported values: disabled | ollama | openai_compatible
MORPHEUS_AI_PROVIDER=disabled
MORPHEUS_AI_MODEL=
MORPHEUS_AI_BASE_URL=
MORPHEUS_AI_API_KEY=
MORPHEUS_AI_TIMEOUT_SECONDS=20

# Example: Ollama on the Docker host.
# MORPHEUS_AI_PROVIDER=ollama
# MORPHEUS_AI_MODEL=<installed-model>
# MORPHEUS_AI_BASE_URL=http://host.docker.internal:11434
#
# Example: OpenAI-compatible server.
# MORPHEUS_AI_PROVIDER=openai_compatible
# MORPHEUS_AI_MODEL=<server-model-id>
# MORPHEUS_AI_BASE_URL=https://your-provider.example/v1
# MORPHEUS_AI_API_KEY=<server-side-key>

# ADVANCED STORAGE/TOOLCHAIN OVERRIDES.
# Normally leave these unset. Docker already sets MORPHEUS_STATE_DIR=/data and
# MORPHEUS_WEB_DIST to the packaged frontend. In the hardened read-only
# container, writable path overrides must remain under /data or /tmp.
#
# MORPHEUS_STATE_DIR=/data
# MORPHEUS_DB_PATH=/data/morpheus.db
# MORPHEUS_ARTIFACT_DIR=/data/artifacts
# MORPHEUS_IDEMPOTENCY_DB_PATH=/data/idempotency.db
#
# Explicit C++ compiler override. Usually unnecessary in the Linux image;
# discover_toolchain() selects g++ deterministically when available.
# MORPHEUS_CXX=/usr/bin/g++
#
# Internal packaged-web override. Do not change in the standard image.
# MORPHEUS_WEB_DIST=/opt/morpheus/frontend/dist
