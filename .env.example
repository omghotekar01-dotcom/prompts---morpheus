# MORPHEUS guarded single-node pilot example.
# Copy this file to .env (ignored by Git) and set a fresh random secret.
# Generate one, for example, with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

MORPHEUS_API_KEY=
MORPHEUS_RATE_LIMIT_PER_MINUTE=120

# Only needed when a browser frontend is hosted on a different origin from the API.
# The packaged Docker UI is same-origin and does not require this setting.
# MORPHEUS_PILOT_BROWSER_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI language/drafting layer.
# Leave MORPHEUS_AI_PROVIDER disabled to run fully deterministic MORPHEUS.
# Supported values: disabled | ollama | openai_compatible
MORPHEUS_AI_PROVIDER=disabled
MORPHEUS_AI_MODEL=
MORPHEUS_AI_BASE_URL=
MORPHEUS_AI_API_KEY=
MORPHEUS_AI_TIMEOUT_SECONDS=20

# Example for Ollama running on the Docker host:
# MORPHEUS_AI_PROVIDER=ollama
# MORPHEUS_AI_MODEL=<your-installed-model>
# MORPHEUS_AI_BASE_URL=http://host.docker.internal:11434
#
# Example for an OpenAI-compatible server:
# MORPHEUS_AI_PROVIDER=openai_compatible
# MORPHEUS_AI_MODEL=<server-model-id>
# MORPHEUS_AI_BASE_URL=https://your-provider.example/v1
# MORPHEUS_AI_API_KEY=<server-side-key>
