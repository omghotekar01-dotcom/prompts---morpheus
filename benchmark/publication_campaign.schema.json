{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morpheus.local/schemas/publication_campaign.schema.json",
  "title": "MORPHEUS Publication Benchmark Campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "git_commit",
    "machine_profile_sha256",
    "workload_manifest_sha256",
    "compiler",
    "build_mode",
    "repetitions",
    "warmup_repetitions",
    "random_seed",
    "environment",
    "claim_scope"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "machine_profile_sha256": {"$ref": "#/$defs/sha256"},
    "workload_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "flags"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "build_mode": {"enum": ["release", "relwithdebinfo"]},
    "repetitions": {"type": "integer", "minimum": 10},
    "warmup_repetitions": {"type": "integer", "minimum": 1},
    "random_seed": {"type": "integer", "minimum": 0},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "cpu_governor", "affinity_policy", "background_load_policy", "clock_source"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "cpu_governor": {"type": "string", "minLength": 1},
        "affinity_policy": {"type": "string", "minLength": 1},
        "background_load_policy": {"type": "string", "minLength": 1},
        "clock_source": {"type": "string", "minLength": 1},
        "turbo_policy": {"type": "string"},
        "thermal_policy": {"type": "string"}
      }
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "forbidden": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "raw_output_directory": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
